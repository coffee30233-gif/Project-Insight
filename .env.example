# 投影機情報站 — 環境變數範本
# 複製成 .env（.env 本身不進 git，見 .gitignore），填好值。
# 這份檔案只給「跑爬蟲/報告/寄信的那台機器」用——不是 Vercel 的環境變數
# （Vercel 專案設定另外要填 GITHUB_TOKEN / GITHUB_REPO / GITHUB_BRANCH，見檔尾）。

# --- Gemini API（必填）---
# https://aistudio.google.com 取得。免費額度請參考 gemini_client.py 開頭的說明。
GEMINI_API_KEY=

# --- 週報寄信 / 失敗告警信用的 SMTP（必填才能寄信，不填只是不寄信，其他功能不受影響）---
# Gmail 用 smtp.gmail.com；公司信箱多半是 smtp.office365.com 或公司自己的 SMTP relay，
# 跟你們 IT 要「SMTP 帳密」或「應用程式密碼」（企業信箱常見要另外開通 SMTP AUTH）。
SMTP_HOST=
SMTP_PORT=587
# 這個信箱同時是「登入帳號」也是「寄件者地址」（see send_weekly_email.py / notify.py）。
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=投影機情報站

# --- 失敗告警信收件人（選填）---
# 不填的話告警信會寄給 SMTP_USER 自己。想跟寄件信箱分開（例如寄件用公用信箱、
# 告警想直接進你個人信箱）就填這個。
ALERT_EMAIL=

# --- 網站網址（選填，只用在週報 email 內文的「前往網站」按鈕連結）---
WEBSITE_URL=https://your-site.vercel.app

# --- Gemini 免費額度節流（選填，有預設值，通常不用改）---
# 批次工作（爬蟲/報告）兩次 Gemini 呼叫間至少間隔幾秒，見 gemini_client.py。
GEMINI_MIN_CALL_INTERVAL=5
# 每次爬蟲跑完，最多補處理幾篇「Gemini 處理失敗過」的積壓文章，見 ingest.py。
RETRY_UNPROCESSED_LIMIT=20

# =====================================================================
# 以下不是這份 .env 的內容，是「另一個地方」要設定的，列在這裡方便對照：
#
# Vercel 專案 → Settings → Environment Variables（給 api/subscribe.py 用）：
#   GITHUB_TOKEN   GitHub Personal Access Token，對這個 repo 要有 Contents 讀寫權限
#   GITHUB_REPO    格式 "owner/repo"，例如 "coffee30233-gif/Project-Insight"
#   GITHUB_BRANCH  通常是 "main"
#   （VERCEL 這個變數 Vercel 平台會自動設定，不用手動加；db.py 靠它判斷
#    「現在是不是跑在 Vercel 上」，這台跑爬蟲的機器絕對不能設這個變數）
# =====================================================================

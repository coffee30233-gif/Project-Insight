{
  "headers": [
    {
      "source": "/(style.css|app.js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "functions": {
    "api/ask.py": {
      "maxDuration": 60
    },
    "api/subscribe.py": {
      "maxDuration": 20
    }
  }
}
